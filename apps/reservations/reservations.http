@authHost = http://localhost:3001
@host = http://localhost:3000
@id = 6a764084aef999ea0327305c

### Login (same file so the Authentication cookie can be chained below)
# @name login
POST {{authHost}}/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "StrongP@ss1"
}

### Create reservation — reuses the cookie from the login above.
# Set-Cookie carries `Authentication=<token>; Path=/; ...`; cookie-parser reads
# the token and ignores the rest. Tip: the cookie jar (rememberCookiesFor-
# SubsequentRequests, on by default) may already send it since cookies aren't
# port-scoped — try deleting the Cookie line and see if it still returns 201.
POST {{host}}/reservations
Content-Type: application/json
Cookie: {{login.response.headers.Set-Cookie}}

{
  "startDate": "02-01-2023",
  "endDate": "02-05-2023",
  "placeId": "123",
  "charge": {
    "amount": 5,
    "card": {
      "cvc": "413",
      "exp_month": 12,
      "exp_year": 2027,
      "number": "4242 4242 4242 4242"
    }
  }
}

### Get all reservations
GET {{host}}/reservations
Cookie: {{login.response.headers.Set-Cookie}}

### Get one reservation
GET {{host}}/reservations/{{id}}
Cookie: {{login.response.headers.Set-Cookie}}

### Update reservation
PATCH {{host}}/reservations/{{id}}
Content-Type: application/json
Cookie: {{login.response.headers.Set-Cookie}}

{
  "placeId": "67890"
}

### Delete reservation
DELETE {{host}}/reservations/{{id}}
Cookie: {{login.response.headers.Set-Cookie}}
